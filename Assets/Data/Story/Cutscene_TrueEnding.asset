  m_Script: {fileID: 11500000, guid: ddb7f0644ca9c6f44b9ca1fe3db5ccb2, type: 3}
  m_Name: Cutscene_TrueEnding
  m_EditorClassIdentifier: Assembly-CSharp::WeatherForSale.Story.CutsceneData
  id: 3
  slides:
  - background: {fileID: 21300000, guid: d73f0b3ea43b90140a57b88fe2f4335d, type: 3}
    backgroundColor: {r: 0.25, g: 0.18, b: 0.35, a: 1}
    portrait: {fileID: 0}
    portraitRight: 0
    portraitOverPicture: 0
    speaker: 
    text: With one last roar, Tempest spirals into the bottle. The glass flashes
      every colour of the rainbow - and the cork slams shut. POP!
    flash: 0
    shake: 0
    bigCentredText: 0
  - background: {fileID: 21300000, guid: 3d3612ef7e3874a44be406034235a18e, type: 3}
    backgroundColor: {r: 0.25, g: 0.18, b: 0.35, a: 1}
    portrait: {fileID: 21300000, guid: 66ffdb656bbb6fb4bb445019f870ff37, type: 3}
    portraitRight: 1
    portraitOverPicture: 0
    speaker: Tempest
    text: Hmph... Fine. You win, little shopkeeper. I'll stay in here... for now.
    flash: 0
    shake: 0
    bigCentredText: 0
  - background: {fileID: 21300000, guid: 07321d02b8c04374ca85b3c5661fe0d1, type: 3}
    backgroundColor: {r: 0.55, g: 0.85, b: 1, a: 1}
    portrait: {fileID: 0}
    portraitRight: 0
    portraitOverPicture: 0
    speaker: 
    text: The clouds tear open. Sunlight pours over the town, and a rainbow stretches
      from one end of the sky to the other.
    flash: 0
    shake: 0
    bigCentredText: 0
  - background: {fileID: 21300000, guid: 98dd0aa846c30bc42a4bc87f7ec88dfe, type: 3}
    backgroundColor: {r: 0.55, g: 0.85, b: 1, a: 1}
    portrait: {fileID: 21300000, guid: 97699195a1fc0f74a9c6292a36b0dfbc, type: 3}
    portraitRight: 1
    portraitOverPicture: 0
    speaker: Uncle John
    text: Sam... you didn't just run the shop. You saved the whole town. I've never
      been prouder of you.
    flash: 0
    shake: 0
    bigCentredText: 0
  - background: {fileID: 21300000, guid: 661d66670203f7a439b4cff65ab02e35, type: 3}
    backgroundColor: {r: 0.55, g: 0.85, b: 1, a: 1}
    portrait: {fileID: 21300000, guid: e3a2413316bbb0c4c90e5402161d845a, type: 3}
    portraitRight: 0
    portraitOverPicture: 0
    speaker: Sam
    text: Then let's make it official - Weather for Sale is OPEN for business!
    flash: 0
    shake: 0
    bigCentredText: 0
